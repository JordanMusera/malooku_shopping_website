# Copy to .env.local for development; configure these separately in Vercel.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/malooku_db
JWT_SECRET=

# M-Pesa sandbox testing requests KSh 1, regardless of the displayed cart total.
MPESA_ENVIRONMENT=sandbox
MPESA_TEST_AMOUNT=1
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR_DOMAIN/api/payments/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signup verification and password reset email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-verified-sender@gmail.com
SMTP_PASS=
MAIL_FROM="Malooku <your-verified-sender@gmail.com>"
OTP_SECRET=generate-a-long-random-secret
